# SOC Lab environment variables - copy to .env and adjust
#   cp .env.example .env
# ---------------------------------------------------------------------------
# VMware host-only networks
# ---------------------------------------------------------------------------
LAN_VMNET="vmnet2"
DMZ_VMNET="vmnet3"

LAN_SUBNET="192.168.10.0"
LAN_NETMASK="255.255.255.0"
DMZ_SUBNET="192.168.20.0"
DMZ_NETMASK="255.255.255.0"

# Host-side vmnet adapter addresses (VMware assigns these on the host)
HOST_LAN_IP="192.168.10.1"
HOST_DMZ_IP="192.168.20.1"

# pfSense gateway addresses (one interface per segment)
LAN_GW="192.168.10.254"
DMZ_GW="192.168.20.254"

# ---------------------------------------------------------------------------
# Windows / Active Directory lab
# ---------------------------------------------------------------------------
DOMAIN_NAME="soclab.local"
NETBIOS_NAME="SOCLAB"

WINRM_PASSWORD="ChangeMe123!"                 # local admin (Administrator / Admin)
SAFE_MODE_PASSWORD="ChangeMe123!"             # AD DSRM
DOMAIN_ADMIN_PASSWORD="S0cL@bPassword2026!"   # soclab\labadmin

# ---------------------------------------------------------------------------
# Wazuh SIEM (Ubuntu Server, DMZ)
# ---------------------------------------------------------------------------
WAZUH_IP="192.168.20.10"
WAZUH_SSH_USER="labadmin"

# ---------------------------------------------------------------------------
# Kali attacker VM (LAN)
# ---------------------------------------------------------------------------
KALI_IP="192.168.10.20"
KALI_SSH_USER="kali"

# SSH password used for the Linux hosts above (Wazuh + Kali)
LABADMIN_PASSWORD="ChangeMe123!"
